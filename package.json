{
  "name": "vacation-time-optimizer",
  "description": "Maximize your getaways",
  "private": true,
  "version": "2.0.4",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "prettier-format": "prettier --config .prettierrc --write src/**/*.ts src/**/*.tsx",
    "prettier-watch": "onchange src/**/*.ts src/**/*.tsx -- prettier --write {{changed}}",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "esbuild": "0.25.0",
    "framer-motion": "^10.18.0",
    "react": "^18.3.1",
    "react-calendar": "^4.8.0",
    "react-dom": "^18.3.1",
    "react-icons": "^4.12.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
